---
// Static Astro footer - renders on the server, no JavaScript
const currentYear = new Date().getFullYear()
---

<footer class="bg-slate-900 px-8 py-8 text-slate-400">
  <div class="mx-auto max-w-7xl">
    <div class="flex flex-col items-center justify-between gap-4 md:flex-row">
      <div class="flex items-center space-x-2">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke="currentColor" stroke-width="2" fill="none"/>
        </svg>
        <span class="font-semibold text-white">Inertia.js</span>
      </div>
      <p class="text-sm">
        &copy; {currentYear} Inertia.js. This is an Astro playground demonstrating the hybrid architecture.
      </p>
      <div class="flex space-x-4">
        <a href="https://inertiajs.com" target="_blank" rel="noopener" class="hover:text-white transition-colors">
          Docs
        </a>
        <a href="https://github.com/inertiajs/inertia" target="_blank" rel="noopener" class="hover:text-white transition-colors">
          GitHub
        </a>
      </div>
    </div>
  </div>
</footer>


