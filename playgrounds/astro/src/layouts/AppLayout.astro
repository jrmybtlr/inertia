---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import InertiaIsland from '@inertiajs/astro/InertiaIsland.astro'
import '../styles/global.css'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Astro + Inertia.js App" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>App - Astro + Inertia</title>
  </head>
  <body class="flex min-h-screen flex-col bg-slate-50">
    <Header />
    <main class="flex-1">
      <InertiaIsland
        id="app"
        class="mx-auto max-w-7xl px-8 py-8"
        fallback="Loading application..."
      />
    </main>
    <Footer />
  </body>
</html>


